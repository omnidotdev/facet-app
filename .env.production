# Production Omni service URLs, baked into every production build (`vite build`).
#
# The web deployment also receives these as infra build args, which take
# precedence, so this file is what configures the DESKTOP (Tauri) build, which
# gets no infra env. Without it a desktop build leaves VITE_AUTH_BASE_URL and
# VITE_FACET_API_URL unset, so isAuthConfigured() is false and the AI gateway is
# absent: managed sign-in and AI generation are silently unavailable on the
# desktop app (local modeling and export still work). These are public URLs, no
# secrets. Dev builds (mode development) do not load this file, so local dev
# stays anonymous and offline.
VITE_FACET_API_URL=https://api.facet.omni.dev
VITE_AUTH_BASE_URL=https://identity.omni.dev
VITE_ACCOUNT_URL=https://account.omni.dev
