{
  "name": "@omnidotdev/facet",
  "version": "0.1.0",
  "private": true,
  "description": "Facet - code-first parametric CAD. Write TypeScript, get geometry.",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/omnidotdev/facet-app.git"
  },
  "license": "Apache-2.0",
  "author": "Omni <team@omni.dev>",
  "keywords": [
    "cad",
    "parametric",
    "csg",
    "3d",
    "wasm"
  ],
  "scripts": {
    "dev": "vite",
    "routes:generate": "tsr generate",
    "opgraph:generate": "bash scripts/opgraph-generate.sh",
    "build": "tsr generate && tsc && vite build",
    "preview": "vite preview",
    "wasm:build": "wasm-pack build crates/facet-kernel --target web --out-dir ../../src/wasm --release",
    "tauri": "tauri",
    "tauri:ios:init": "tauri ios init",
    "tauri:ios:dev": "tauri ios dev",
    "tauri:ios:build": "tauri ios build",
    "tauri:android:init": "tauri android init",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build",
    "format": "biome format --write",
    "lint": "biome lint",
    "check": "biome check --diagnostic-level=error src",
    "knip": "knip-bun --tags=-knipignore",
    "test": "bun test src",
    "version": "changeset version && bun scripts/syncVersion.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@ark-ui/react": "^5.30.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.3",
    "@omnidotdev/thornberry": "github:omnidotdev/thornberry#a93c95f59c5d323ded3b61456cc1b01749ce144f",
    "@tanstack/react-router": "^1.170.38",
    "@tauri-apps/api": "~2.12.0",
    "@tauri-apps/plugin-deep-link": "~2.6.0",
    "@tauri-apps/plugin-geolocation": "~2.5.0",
    "@tauri-apps/plugin-notification": "~2.8.0",
    "@tauri-apps/plugin-opener": "~2.7.0",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-updater": "~2.14.0",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "lucide-react": "^0.563.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hotkeys-hook": "^5.3.2",
    "replicad": "1.2.0",
    "replicad-opencascadejs": "1.1.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typegpu": "0.12.9",
    "wgpu-matrix": "3.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.31.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.6.1",
    "@tanstack/router-cli": "^1.167.38",
    "@tanstack/router-plugin": "^1.168.40",
    "@tauri-apps/cli": "^2.11.5",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@webgpu/types": "^0.1.74",
    "husky": "^9.1.7",
    "knip": "^5.88.1",
    "typescript": "^5.9.3",
    "unplugin-typegpu": "0.12.5",
    "vite": "^6.4.3",
    "vite-plugin-mkcert": "^2.1.0",
    "vite-plugin-pwa": "2.0.0"
  }
}
