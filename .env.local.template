# Facet app environment. Copy to .env.local and fill in as needed.
# Every value is optional: the app runs fully as a static SPA with none set.

# Base URL of the Facet AI gateway (facet-api), used by the "Describe a part"
# panel. When unset, the AI panel is hidden and the app still models locally.
# Example: VITE_FACET_API_URL=https://facet-api.omni.dev
VITE_FACET_API_URL=

# Base URL of the Omni Gatekeeper identity provider, used to sign in for the
# MANAGED (Facet's-Synapse-key) generation path only. Bring-your-own-key
# generation (the caller's own Synapse key, minted at https://synapse.omni.dev)
# and all local modeling stay anonymous and never need this. When unset, the
# managed path cannot sign in and only BYOK generates. Both generation paths run
# through the Synapse AI router. Matches the fleet convention (aspen-app,
# arbor-app).
# Example: VITE_AUTH_BASE_URL=https://identity.omni.dev
VITE_AUTH_BASE_URL=

# OPTIONAL override for Facet's public OAuth client id. The app defaults to the
# client id registered with Gatekeeper (baked into the source like aspen-editor's,
# since it is public and stable, not a secret), so prod needs nothing here.
# Managed sign-in runs Authorization Code + PKCE in the browser with the redirect
# URI <origin>/auth/callback, which must be registered for the client in
# Gatekeeper. Set this only to point a non-prod build at a different client.
# Example: VITE_AUTH_CLIENT_ID=<a non-prod client id from Gatekeeper>
VITE_AUTH_CLIENT_ID=

# Base URL of the shared Omni account hub, which owns billing across every Omni
# product. When set, an out-of-credits user sees an "Upgrade workspace" CTA that
# links to the hub's Facet billing page; Facet funnels upgrades there rather
# than running its own checkout. When unset, the CTA is hidden and BYOK still
# works. Matches the fleet convention (VITE_ACCOUNT_URL in arbor-app, etc).
# Example: VITE_ACCOUNT_URL=https://account.omni.dev
VITE_ACCOUNT_URL=
