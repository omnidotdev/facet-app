# Facet app environment. Copy to .env.local and fill in as needed.
# Every value is optional: the app runs fully as a static SPA with none set.

# Base URL of the Facet AI gateway (facet-api), used by the "Describe a part"
# panel. When unset, the AI panel is hidden and the app still models locally.
# Example: VITE_FACET_API_URL=https://facet-api.omni.dev
VITE_FACET_API_URL=
